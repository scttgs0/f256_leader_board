
;--------------------------------------
; Zero-page equates
;--------------------------------------

zp3D                    = $003D         ; [word]
zp3F                    = $003F         ; [word]

;!!MISL_BASE       = $0060
;!!_HPOSM1_BallR   = $0061 ;HPOSM1
;!!_HPOSM3_BallL   = $0063 ;HPOSM3

zp82                    = $0082         ; [word]
zp84                    = $0084         ; [word]

zpMMU                   = $00C0
zpMMU_XBPC              = $00C1         ; preserve bank during X-Bank Procedure Call
zpCharToPlot            = $00C2

zpC3                    = $00C3         ; [word]
zpC5                    = $00C5
zpCD                    = $00CD         ; [word]
zpCF                    = $00CF

zpD0                    = $00D0
zpD1                    = $00D1
zpD2                    = $00D2
zpD4                    = $00D4         ; [word]
zpD7                    = $00D7         ; [word]
zpDB                    = $00DB         ; [word]

zpF3                    = $00F3         ; [5-bytes]

zpF8                    = $00F8         ; _ptrPolyVertX_LO
zpF9                    = $00F9
zpFA                    = $00FA         ; _ptrPolyVertX_HI
zpFB                    = $00FB
zpFC                    = $00FC         ; _ptrPolyVertY_LO
zpFD                    = $00FD
zpFE                    = $00FE         ; _ptrPolyVertY_HI
zpFF                    = $00FF


;--------------------------------------
;--------------------------------------

JIFFYCLOCK              = $0085

KEYCHAR                 = $008A         ; last key pressed ascii
KEYCODE                 = $008B         ; last key pressed raw
CONSOL                  = $008C         ; state of OPTION,SELECT,START

zpSource                = $008D         ; [long] Starting address for the source data
zpDest                  = $0090         ; [long] Starting address for the destination block

RND_MIN                 = $0093
RND_SEC                 = $0094
RND_RESULT              = $0095         ; [2 bytes]

irq_pending             = $0097

DEBOUNCE                = $0098

priorIRQ_BRK            = $009A

                .virtual $00A0
kernelEvt               .dstruct kernel.event.event_t
                .endvirtual
